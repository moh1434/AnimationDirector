# Settings for this computer. Copy this file to ".env" (setup.bat does it for you) and adjust.
# The pipeline checks these every time it runs and stops with a clear message if something is wrong.

# whisper.cpp gives exact word timing: captions and objects that appear on a word use it.
# The whisper.cpp folder, relative to this project folder (or an absolute path).
# Leave it empty (WHISPER_PATH="") to turn whisper off; word times are then estimated from the voice.
WHISPER_PATH="../whisper.cpp/"

# Models are names from <WHISPER_PATH>/models (file ggml-<name>.bin), or a path to a .bin file.
# The two settings may name the same model: a multilingual one (no ".en") such as large-v3-turbo
# works for English and Arabic, so you only need one download. A ".en" model is English only.
# Download one (Windows):  cd ..\whisper.cpp\models   then   .\download-ggml-model.cmd large-v3-turbo

# Model for English narration:
#   small.en (good, fast) · base.en (faster) · large-v3-turbo (best, slower, also does Arabic)
WHISPER_EN_MODEL="small.en"

# Model for Arabic (and any other non-English) narration. It must be multilingual (no ".en"):
#   large-v3-turbo (best for Arabic) · medium · small
# Use the same value as WHISPER_EN_MODEL to keep one model for both languages.
# Leave it empty to estimate Arabic word times instead.
WHISPER_AR_MODEL="large-v3-turbo"

# Bundler Remotion uses to build the video code before rendering and for Studio (optional).
#   rspack (default, ~4x faster to start) · webpack (the old one; use it if something looks wrong)
REMOTION_BUNDLER="rspack" #OR webpack

# What renders the video (optional). If the GPU fails, the render retries on the CPU by itself.
#   gpu (default: an NVIDIA card draws and encodes, faster, bigger files) · cpu (works on any computer)
REMOTION_RENDERER="gpu" #OR cpu

# Frame rate of the videos (optional): 24, 25, 30, 50 or 60. 30 when missing.
# A project's video.json can still set its own "fps".
VIDEO_FPS="30"


GOOGLE_API_KEY=-dxg
GOOGLE_NAME=NAME
GOOGLE_PROJECT_NAME=projects/5
GOOGLE_PROJECT_NUMBER=485

# Voices from text (optional, see TTS.md): the folder of each model, with its .venv and weights.
# Audar-TTS Turbo clones a reference recording, in English and Arabic (the default engine).
# Qwen3-TTS (English only) designs new voices from a description (weights/) and clones (weights-base/).
# Leave them empty if you always supply your own recordings.
TTS_AUDAR_DIR="C:/Users/USER_NAME/tts-new-models/audar-turbo"
TTS_QWEN3_DIR="C:/Users/USER_NAME/tts-new-models/qwen3-tts"
# The uv program that runs them (default: uv on the PATH).
# TTS_UV="C:/Users/USER_NAME/.local/bin/uv.exe"
