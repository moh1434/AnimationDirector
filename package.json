{
  "name": "my-custom-setup",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "vendor": "node scripts/vendor.mjs",
    "video": "node pipeline/cli.mjs",
    "make": "node pipeline/cli.mjs make",
    "doctor": "node pipeline/cli.mjs doctor",
    "studio": "remotion studio remotion/index.ts",
    "render": "remotion render remotion/index.ts DidYouKnow out/did-you-know.mp4",
    "hf:preview": "hyperframes preview hyperframes",
    "hf:check": "hyperframes check hyperframes",
    "hf:render": "hyperframes render hyperframes -o out/hyperframes.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "gsap": "3.15.0",
    "hyperframes": "0.8.230",
    "puppeteer-core": "25.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "webpack": "5.112.0"
  }
}