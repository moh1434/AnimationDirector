    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "gsap": "^3.15.0",
    "hyperframes": "0.8.230",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
