  "dialogue": [
    {
      "clip": 1,
      "who": "benny",
      "start": 0.25,
      "end": 2.34,
      "text": "How can a snail rescue a star?"
    },
    {
      "clip": 2,
      "who": "cherry",
      "start": 2.59,
      "end": 5.75,
      "text": "We haven't managed. I'm open to suggestions."
    },
    {
      "clip": 3,
      "who": "berry",
      "start": 6,
      "end": 7.4,
      "text": "Is that the one from the tree?"
    },
    {
      "clip": 4,
      "who": "benny",
      "start": 7.65,
      "end": 8.98,
      "text": "The one I stepped over."
    },
    {
      "clip": 5,
      "who": "cherry",
      "start": 9.23,
      "end": 11.690000000000001,
      "text": "Get down here. Look along the water."
    },
    {
      "clip": 6,
      "who": "berry",
      "start": 11.940000000000001,
      "end": 13.690000000000001,
      "text": "There was a road here the whole time?"
    },
    {
      "clip": 7,
      "who": "benny",
      "start": 13.940000000000001,
      "end": 15.180000000000001,
      "text": "We were looking over it."
    },
    {
      "clip": 8,
      "who": "cherry",
      "start": 15.430000000000001,
      "end": 17.85,
      "text": "It's disappearing where the sunlight touches it."
    },
    {
      "clip": 9,
      "who": "berry",
      "start": 18.1,
      "end": 19.43,
      "text": "Then we need to move."
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 19.68,
      "end": 22.52,
      "text": "The reeds block this end. Where does it start?"
    },
    {
      "clip": 11,
      "who": "benny",
      "start": 22.72,
      "end": 25.169999999999998,
      "text": "There! Beside that flat stone."
    },
    {
      "clip": 12,
      "who": "berry",
      "start": 25.419999999999998,
      "end": 27.229999999999997,
      "text": "Your hill finally has a job."
    },
    {
      "clip": 13,
      "who": "benny",
      "start": 27.479999999999997,
      "end": 30.639999999999997,
      "text": "Excellent views. Terrible launching facilities."
    },
    {
      "clip": 14,
      "who": "berry",
      "start": 30.889999999999997,
      "end": 32.76,
      "text": "The tower works better lying down."
    },
    {
      "clip": 15,
      "who": "cherry",
      "start": 33.01,
      "end": 35.9,
      "text": "Hold it steady. Our guide's coming across."
    },
    {
      "clip": 16,
      "who": "benny",
      "start": 36.15,
      "end": 39.379999999999995,
      "text": "No rush, little one. Except... quite a lot of rush."
    },
    {
      "clip": 17,
      "who": "cherry",
      "start": 39.629999999999995,
      "end": 42.55,
      "text": "There's your way home. Right where we weren't looking."
    },
    {
      "clip": 18,
      "who": "berry",
      "start": 42.8,
      "end": 44.94,
      "text": "Go on. We'll watch you get there."
    },
    {
      "clip": 19,
      "who": "benny",
      "start": 45.19,
      "end": 45.949999999999996,
      "text": "It made it."
    },
    {
      "clip": 20,
      "who": "berry",
      "start": 46.199999999999996,
      "end": 49.08,
      "text": "All that work. We never asked our guide's name."
    },
    {
      "clip": 21,
      "who": "cherry",
      "start": 49.33,
      "end": 50.629999999999995,
      "text": "Same time tomorrow?"
    },
    {
      "clip": 22,
      "who": "benny",
      "start": 50.879999999999995,
      "end": 52.599999999999994,
      "text": "Let's just lose a sock next time."
    }
  ],
