      "who": "benny",
      "start": 0.25,
      "end": 2.44,
      "text": "Why can't I move this stupid bench?"
    },
    {
      "clip": 2,
      "who": "berry",
      "start": 2.69,
      "end": 3.46,
      "text": "Want a hand?"
    },
    {
      "clip": 3,
      "who": "benny",
      "start": 3.71,
      "end": 6.96,
      "text": "No. I built it myself. I'll move it myself."
    },
    {
      "clip": 4,
      "who": "cherry",
      "start": 7.21,
      "end": 8.62,
      "text": "Where are we moving it?"
    },
    {
      "clip": 5,
      "who": "benny",
      "start": 8.87,
      "end": 12.239999999999998,
      "text": "Outside. Best spot in the garden. Before sunset."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 12.45,
      "end": 13.104999999999999,
      "text": "Stay."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 13.354999999999999,
      "end": 15.155,
      "text": "I don't think doors learn commands."
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 15.405,
      "end": 17.915,
      "text": "This one will. We've spent enough time together."
    },
    {
      "clip": 9,
      "who": "cherry",
      "start": 18.165,
      "end": 19.349999999999998,
      "text": "You've run out of arms."
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 19.599999999999998,
      "end": 21.269999999999996,
      "text": "I've still got a perfectly good chin."
    },
    {
      "clip": 11,
      "who": "berry",
      "start": 21.519999999999996,
      "end": 22.869999999999997,
      "text": "Please keep that attached."
    },
    {
      "clip": 12,
      "who": "benny",
      "start": 23.119999999999997,
      "end": 26.029999999999998,
      "text": "I wanted you to see something I'd done all by myself."
    },
    {
      "clip": 13,
      "who": "cherry",
      "start": 26.279999999999998,
      "end": 28.384999999999998,
      "text": "We saw. It's a lovely bench."
    },
    {
      "clip": 14,
      "who": "benny",
      "start": 28.634999999999998,
      "end": 30.834999999999997,
      "text": "It looks less impressive stuck in a doorway."
    },
    {
      "clip": 15,
      "who": "berry",
      "start": 31.084999999999997,
      "end": 32.57,
      "text": "Only the moving part is stuck."
    },
    {
      "clip": 16,
      "who": "benny",
      "start": 32.82,
      "end": 34.18,
      "text": "Feels like the whole thing."
    },
    {
      "clip": 17,
      "who": "benny",
      "start": 34.33,
      "end": 35.87,
      "text": "You didn't even think about asking."
    },
    {
      "clip": 18,
      "who": "berry",
      "start": 36.12,
      "end": 38.419999999999995,
      "text": "I had full hands. She had a free one."
    },
    {
      "clip": 19,
      "who": "benny",
      "start": 38.669999999999995,
      "end": 41.91,
      "text": "Berry, the door? Cherry, the other end?"
    },
    {
      "clip": 20,
      "who": "cherry",
      "start": 42.16,
      "end": 43.26,
      "text": "Ready when you are."
    },
    {
      "clip": 21,
      "who": "benny",
      "start": 43.51,
      "end": 44.89,
      "text": "Together. Lift."
    },
    {
      "clip": 22,
      "who": "berry",
      "start": 45.14,
      "end": 46.080041666666666,
      "text": "Still your bench."
    },
    {
      "clip": 23,
      "who": "benny",
      "start": 46.330041666666666,
      "end": 47.540125,
      "text": "Better with people on it."
    }
  ],
