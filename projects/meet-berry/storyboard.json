  "dialogue": [
    {
      "clip": 1,
      "who": "berry",
      "start": 0.25,
      "end": 3.72,
      "text": "Hi! I'm Berry, the new leader of this channel!"
    },
    {
      "clip": 2,
      "who": "curly",
      "start": 3.97,
      "end": 7.82,
      "text": "And I'm her best friend! I do all the hard work."
    },
    {
      "clip": 3,
      "who": "berry",
      "start": 8.32,
      "end": 10,
      "text": "That is... not true."
    },
    {
      "clip": 4,
      "who": "curly",
      "start": 10.25,
      "end": 12.355,
      "text": "Okay. I bring all the snacks."
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 12.605,
      "end": 15.185,
      "text": "On this channel, we tell you fun stories."
    },
    {
      "clip": 6,
      "who": "curly",
      "start": 15.435,
      "end": 18.735,
      "text": "With cats! And robots! And giant cookies!"
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 18.985,
      "end": 20.509999999999998,
      "text": "Maybe not giant cookies."
    },
    {
      "clip": 8,
      "who": "curly",
      "start": 20.959999999999997,
      "end": 22.849999999999998,
      "text": "Definitely giant cookies."
    },
    {
      "clip": 9,
      "who": "berry",
      "start": 23.099999999999998,
      "end": 25.869999999999997,
      "text": "So follow us, and see you in the next video!"
    },
    {
      "clip": 10,
      "who": "curly",
      "start": 26.169999999999998,
      "end": 26.97,
      "text": "Bye bye!"
    }
  ],
