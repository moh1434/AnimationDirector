  "clips": [
    {
      "who": "cherry",
      "file": "voices/01-cherry.wav",
      "text": "How long have you been open?"
    },
    {
      "who": "benny",
      "file": "voices/02-benny.wav",
      "text": "Since ten."
    },
    {
      "who": "cherry",
      "file": "voices/03-cherry.wav",
      "text": "It's four."
    },
    {
      "who": "benny",
      "file": "voices/04-benny.wav",
      "text": "People get hungry at different times."
    },
    {
      "who": "berry",
      "file": "voices/05-berry.wav",
      "text": "I've done ribbons for twelve boxes."
    },
    {
      "who": "benny",
      "file": "voices/06-benny.wav",
      "text": "See? We're ready."
    },
    {
      "who": "benny",
      "file": "voices/07-benny.wav",
      "text": "Was that...",
      "gap": 2.6
    },
    {
      "who": "cherry",
      "file": "voices/08-cherry.wav",
      "text": "It was!"
    },
    {
      "who": "benny",
      "file": "voices/09-benny.wav",
      "text": "Order! One order of noodles!"
    },
    {
      "who": "benny",
      "file": "voices/10-benny.wav",
      "text": "I'm telling them twenty minutes.",
      "gap": 0.8
    },
    {
      "who": "berry",
      "file": "voices/11-berry.wav",
      "text": "Benny, do noodles take twenty minutes?"
    },
    {
      "who": "benny",
      "file": "voices/12-benny.wav",
      "text": "They do now."
    },
    {
      "who": "cherry",
      "file": "voices/13-cherry.wav",
      "text": "Dad, the address is...",
      "gap": 1
    },
    {
      "who": "benny",
      "file": "voices/14-benny.wav",
      "text": "One second, sweetheart."
    },
    {
      "who": "berry",
      "file": "voices/15-berry.wav",
      "text": "This box needs the yellow ribbon."
    },
    {
      "who": "benny",
      "file": "voices/16-benny.wav",
      "text": "Berry, it's noodles."
    },
    {
      "who": "berry",
      "file": "voices/17-berry.wav",
      "text": "It's the first noodles."
    },
    {
      "who": "benny",
      "file": "voices/18-benny.wav",
      "text": "Yellow, then.",
      "gap": 2.1
    },
    {
      "who": "cherry",
      "file": "voices/19-cherry.wav",
      "text": "Mom, it says...",
      "gap": 0.5
    },
    {
      "who": "berry",
      "file": "voices/20-berry.wav",
      "text": "Put your finger on the knot, honey."
    },
    {
      "who": "benny",
      "file": "voices/21-benny.wav",
      "text": "It's getting cold! Go!",
      "gap": 2.6
    },
    {
      "who": "benny",
      "file": "voices/22-benny.wav",
      "text": "Look at that. Off to a total stranger.",
      "gap": 1.9
    },
    {
      "who": "cherry",
      "file": "voices/23-cherry.wav",
      "text": "Dad."
    },
    {
      "who": "benny",
      "file": "voices/24-benny.wav",
      "text": "Let me have this, Cherry."
    },
    {
      "who": "benny",
      "file": "voices/25-benny.wav",
      "text": "Did he forget something?",
      "gap": 4.6
    },
    {
      "who": "wendy",
      "file": "voices/26-wendy.wav",
      "text": "Eighteen minutes. Not bad.",
      "gap": 1.5
    },
    {
      "who": "benny",
      "file": "voices/27-benny.wav",
      "text": "Wendy?"
    },
    {
      "who": "wendy",
      "file": "voices/28-wendy.wav",
      "text": "That's mine, Dad. I ordered it."
    },
    {
      "who": "cherry",
      "file": "voices/29-cherry.wav",
      "text": "It's our address. I kept saying."
    },
    {
      "who": "wendy",
      "file": "voices/30-wendy.wav",
      "text": "Nobody ordered all day. I thought your page was broken.",
      "gap": 1.2
    },
    {
      "who": "wendy",
      "file": "voices/31-wendy.wav",
      "text": "So I tested it.",
      "gap": 0.74
    },
    {
      "who": "benny",
      "file": "voices/32-benny.wav",
      "text": "Well. It works great.",
      "gap": 2.1
    },
    {
      "who": "benny",
      "file": "voices/33-benny.wav",
      "text": "And I got to yell \"order.\" I've always wanted to yell that.",
      "gap": 0.71
    },
    {
      "who": "wendy",
      "file": "voices/34-wendy.wav",
      "text": "I should've told you."
    },
    {
      "who": "benny",
      "file": "voices/35-benny.wav",
      "text": "I just really thought it was somebody.",
      "gap": 0.8
    },
    {
      "who": "wendy",
      "file": "voices/36-wendy.wav",
      "text": "It was somebody. I was hungry.",
      "gap": 0.5
    },
    {
      "who": "cherry",
      "file": "voices/37-cherry.wav",
      "text": "Do we get to rate it?",
      "gap": 4.2
    },
    {
      "who": "wendy",
      "file": "voices/38-wendy.wav",
      "text": "Four stars."
    },
    {
      "who": "benny",
      "file": "voices/39-benny.wav",
      "text": "Four?"
    },
    {
      "who": "wendy",
      "file": "voices/40-wendy.wav",
      "text": "The ribbon slowed it down."
    },
    {
      "who": "berry",
      "file": "voices/41-berry.wav",
      "text": "The ribbon was perfect."
    },
    {
      "who": "benny",
      "file": "voices/42-benny.wav",
      "text": "Not you?",
      "gap": 3.4
    },
    {
      "who": "wendy",
      "file": "voices/43-wendy.wav",
      "text": "Not me."
    },
    {
      "who": "cherry",
      "file": "voices/44-cherry.wav",
      "text": "Dad. It's across town.",
      "gap": 1.2
    },
    {
      "who": "benny",
      "file": "voices/45-benny.wav",
      "text": "Order!",
      "gap": 2.6
    }
  ]
}
