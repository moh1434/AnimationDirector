{
  "language": "ar",
  "takes": 3,
  "voices": {
    "berry": {
      "library": "berry"
    },
    "benny": {
      "library": "benny"
    },
    "cherry": {
      "library": "cherry"
    }
  },
  "lines": [
    {
      "who": "benny",
      "text": "لماذا لا أستطيع تحريك هذا المقعد السخيف؟"
    },
    {
      "who": "berry",
      "text": "تريد مساعدة؟"
    },
    {
      "who": "benny",
      "text": "لا. صنعته بنفسي، وسأحرّكه بنفسي."
    },
    {
      "who": "cherry",
      "text": "إلى أين سننقله؟"
    },
    {
      "who": "benny",
      "text": "إلى الخارج. أجمل مكان في الحديقة. قبل غروب الشمس."
    },
    {
      "who": "benny",
      "text": "ابقَ مفتوحًا."
    },
    {
      "who": "berry",
      "text": "لا أظن أن الأبواب تفهم الأوامر."
    },
    {
      "who": "benny",
      "text": "هذا الباب سيفهم. قضينا معًا وقتًا طويلًا."
    },
    {
      "who": "cherry",
      "text": "لم تعد لديك أيدٍ كافية."
    },
    {
      "who": "benny",
      "text": "ما زال لديّ ذقنٌ ممتاز."
    },
    {
      "who": "berry",
      "text": "أرجوك، أبقِه في مكانه."
    },
    {
      "who": "benny",
      "text": "أردتُ أن تريا شيئًا صنعته وحدي تمامًا."
    },
    {
      "who": "cherry",
      "text": "رأيناه. إنه مقعد جميل."
    },
    {
      "who": "benny",
      "text": "يبدو أقل روعة وهو عالق عند الباب."
    },
    {
      "who": "berry",
      "text": "المقعد رائع، المشكلة فقط في نقله."
    },
    {
      "who": "benny",
      "text": "أشعر أن كل شيء عالق."
    },
    {
      "who": "benny",
      "text": "لم تفكّري حتى في أن تطلبي."
    },
    {
      "who": "berry",
      "text": "كانت يداي مشغولتين، وكانت لديها يد حرة."
    },
    {
      "who": "benny",
      "text": "بيري، الباب؟ شيري، الطرف الآخر؟"
    },
    {
      "who": "cherry",
      "text": "جاهزة متى أردت."
    },
    {
      "who": "benny",
      "text": "معًا. ارفعوا!"
    },
    {
      "who": "berry",
      "text": "ما زال مقعدك."
    },
    {
      "who": "benny",
      "text": "وأجمل مع من يجلسون عليه."
    }
  ]
}
