  "dialogue": [
    {
      "clip": 1,
      "who": "benny",
      "start": 0.25,
      "end": 2.17,
      "text": "Why can't I move this stupid bench?"
    },
    {
      "clip": 2,
      "who": "berry",
      "start": 2.42,
      "end": 3.165,
      "text": "Want a hand?"
    },
    {
      "clip": 3,
      "who": "benny",
      "start": 3.415,
      "end": 6.695,
      "text": "No. I built it myself. I'll move it myself."
    },
    {
      "clip": 4,
      "who": "cherry",
      "start": 6.945,
      "end": 8.235,
      "text": "Where are we moving it?"
    },
    {
      "clip": 5,
      "who": "benny",
      "start": 8.485,
      "end": 12.035,
      "text": "Outside. Best spot in the garden. Before sunset."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 12.255,
      "end": 12.895000000000001,
      "text": "Stay."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 13.145000000000001,
      "end": 14.875000000000002,
      "text": "I don't think doors learn commands."
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 15.125000000000002,
      "end": 17.675,
      "text": "This one will. We've spent enough time together."
    },
    {
      "clip": 9,
      "who": "cherry",
      "start": 17.925,
      "end": 19.045,
      "text": "You've run out of arms."
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 19.295,
      "end": 21.055000000000003,
      "text": "I've still got a perfectly good chin."
    },
    {
      "clip": 11,
      "who": "berry",
      "start": 21.305000000000003,
      "end": 22.635000000000005,
      "text": "Please keep that attached."
    },
    {
      "clip": 12,
      "who": "benny",
      "start": 22.885000000000005,
      "end": 25.805000000000007,
      "text": "I wanted you to see something I'd done all by myself."
    },
    {
      "clip": 13,
      "who": "cherry",
      "start": 26.055000000000007,
      "end": 28.235000000000007,
      "text": "We saw. It's a lovely bench."
    },
    {
      "clip": 14,
      "who": "benny",
      "start": 28.485000000000007,
      "end": 30.865000000000006,
      "text": "It looks less impressive stuck in a doorway."
    },
    {
      "clip": 15,
      "who": "berry",
      "start": 31.115000000000006,
      "end": 32.57000000000001,
      "text": "Only the moving part is stuck."
    },
    {
      "clip": 16,
      "who": "benny",
      "start": 32.82000000000001,
      "end": 34.18000000000001,
      "text": "Feels like the whole thing."
    },
    {
      "clip": 17,
      "who": "benny",
      "start": 34.95000000000001,
      "end": 36.61000000000001,
      "text": "You didn't even think about asking."
    },
    {
      "clip": 18,
      "who": "berry",
      "start": 36.86000000000001,
      "end": 39.2,
      "text": "I had full hands. She had a free one."
    },
    {
      "clip": 19,
      "who": "benny",
      "start": 39.45,
      "end": 44.22,
      "text": "Berry, the door? Cherry, the other end?"
    },
    {
      "clip": 20,
      "who": "cherry",
      "start": 44.47,
      "end": 45.58,
      "text": "Ready when you are."
    },
    {
      "clip": 21,
      "who": "benny",
      "start": 45.83,
      "end": 47.58,
      "text": "Together. Lift."
    },
    {
      "clip": 22,
      "who": "berry",
      "start": 47.83,
      "end": 48.879999999999995,
      "text": "Still your bench."
    },
    {
      "clip": 23,
      "who": "benny",
      "start": 49.129999999999995,
      "end": 50.449999999999996,
      "text": "Better with people on it."
    }
  ],
