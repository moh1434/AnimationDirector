    },
    {
      "clip": 2,
      "who": "berry",
      "start": 3.21,
      "end": 3.8449999999999998,
      "text": "Always?"
    },
    {
      "clip": 3,
      "who": "benny",
      "start": 4.095,
      "end": 6.305,
      "text": "The book's heavier. Easy victory."
    },
    {
      "clip": 4,
      "who": "benny",
      "start": 6.505,
      "end": 8.91,
      "text": "Look at that. The paper's barely trying."
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 9.16,
      "end": 11.86,
      "text": "Same paper. Same book. Another race."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 12.11,
      "end": 14.379999999999999,
      "text": "You can encourage it. It still won't win."
    },
    {
      "clip": 7,
      "who": "benny",
      "start": 14.53,
      "end": 16.96,
      "text": "That's not a race. That's public transport."
    },
    {
      "clip": 8,
      "who": "berry",
      "start": 17.21,
      "end": 19.900000000000002,
      "text": "If weight alone decides, the book should leave it behind."
    },
    {
      "clip": 9,
      "who": "benny",
      "start": 20.150000000000002,
      "end": 21.685000000000002,
      "text": "Fine. But no glue."
    },
    {
      "clip": 10,
      "who": "berry",
      "start": 21.935000000000002,
      "end": 24.330000000000002,
      "text": "No glue. No tricks. Just watch."
    },
    {
      "clip": 11,
      "who": "benny",
      "start": 25.130000000000003,
      "end": 26.950000000000003,
      "text": "It kept up! You didn't make it heavier."
    },
    {
      "clip": 12,
      "who": "berry",
      "start": 27.200000000000003,
      "end": 29.070000000000004,
      "text": "Air was slowing the loose sheet down."
    },
    {
      "clip": 13,
      "who": "benny",
      "start": 29.320000000000004,
      "end": 30.370000000000005,
      "text": "So what changed?"
    },
    {
      "clip": 14,
      "who": "berry",
      "start": 30.620000000000005,
      "end": 33.24,
      "text": "The book shields the paper from most of that resistance."
    },
    {
      "clip": 15,
      "who": "benny",
      "start": 33.49,
      "end": 35.79,
      "text": "So being light wasn't the whole explanation?"
    },
    {
      "clip": 16,
      "who": "berry",
      "start": 36.04,
      "end": 36.82,
      "text": "Exactly."
    },
    {
      "clip": 17,
      "who": "benny",
      "start": 37.07,
      "end": 38.78,
      "text": "Can it give my homework a lift, too?"
    }
  ],
