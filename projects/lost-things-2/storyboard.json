      "end": 6.710000000000001,
      "text": "It's two crates. They passed."
    },
    {
      "clip": 4,
      "who": "cherry",
      "start": 6.960000000000001,
      "end": 8.950000000000001,
      "text": "Did we ask whether it wanted a tower?"
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 9.200000000000001,
      "end": 11.82,
      "text": "Your home's up there. This gets you closer."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 12.07,
      "end": 13.84,
      "text": "Technically, so would a thick hat."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 14.09,
      "end": 15.45,
      "text": "Have you got a better idea?"
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 15.7,
      "end": 17.84,
      "text": "The hill. It's already built."
    },
    {
      "clip": 9,
      "who": "benny",
      "start": 18.06,
      "end": 20.959999999999997,
      "text": "Highest spot around. No assembly required."
    },
    {
      "clip": 10,
      "who": "berry",
      "start": 21.209999999999997,
      "end": 23.859999999999996,
      "text": "Go on. You're nearly... slightly closer."
    },
    {
      "clip": 11,
      "who": "cherry",
      "start": 24.109999999999996,
      "end": 25.909999999999997,
      "text": "It's pointing the other way again."
    },
    {
      "clip": 12,
      "who": "benny",
      "start": 26.159999999999997,
      "end": 27.619999999999997,
      "text": "I carried it all this way."
    },
    {
      "clip": 13,
      "who": "cherry",
      "start": 27.869999999999997,
      "end": 29.939999999999998,
      "text": "That doesn't make this the right place."
    },
    {
      "clip": 14,
      "who": "cherry",
      "start": 30.54,
      "end": 33.68,
      "text": "Before we try another rescue... how did you get down?"
    },
    {
      "clip": 15,
      "who": "berry",
      "start": 33.93,
      "end": 35.12,
      "text": "We never asked that."
    },
    {
      "clip": 16,
      "who": "benny",
      "start": 35.37,
      "end": 38.47,
      "text": "I thought falling was fairly self-explanatory."
    },
    {
      "clip": 17,
      "who": "cherry",
      "start": 38.72,
      "end": 40.16,
      "text": "What were you looking for?"
    },
    {
      "clip": 18,
      "who": "berry",
      "start": 40.41,
      "end": 42.209999999999994,
      "text": "It came down to meet that star."
    },
    {
      "clip": 19,
      "who": "benny",
      "start": 42.459999999999994,
      "end": 43.43999999999999,
      "text": "Its reflection?"
    },
    {
      "clip": 20,
      "who": "cherry",
      "start": 43.68999999999999,
      "end": 45.59999999999999,
      "text": "You thought someone was down there waiting?"
    },
    {
      "clip": 21,
      "who": "berry",
      "start": 45.84999999999999,
      "end": 47.44999999999999,
      "text": "And now it can't find the way back."
    },
    {
      "clip": 22,
      "who": "benny",
      "start": 47.69999999999999,
      "end": 51.32999999999999,
      "text": "We've been solving the wrong problem. Very enthusiastically."
    },
    {
      "clip": 23,
      "who": "cherry",
      "start": 51.57999999999999,
      "end": 53.74999999999999,
      "text": "Let's follow where it's pointing this time."
    }
  ],
