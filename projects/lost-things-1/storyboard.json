  "dialogue": [
    {
      "clip": 1,
      "who": "benny",
      "start": 0.25,
      "end": 2.41,
      "text": "What's knocking from inside that tree?"
    },
    {
      "clip": 2,
      "who": "berry",
      "start": 2.66,
      "end": 5.36,
      "text": "There's a sign. Lost things returned here."
    },
    {
      "clip": 3,
      "who": "cherry",
      "start": 5.61,
      "end": 8.52,
      "text": "Finally. Somewhere for your common sense."
    },
    {
      "clip": 4,
      "who": "benny",
      "start": 8.77,
      "end": 11.14,
      "text": "Mine isn't lost. It's exploring."
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 11.39,
      "end": 13.14,
      "text": "That's the button from my old coat."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 13.39,
      "end": 15.110000000000001,
      "text": "Ask if they've got my other sock."
    },
    {
      "clip": 7,
      "who": "cherry",
      "start": 15.360000000000001,
      "end": 17.040000000000003,
      "text": "Let's start with whatever knocked."
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 17.290000000000003,
      "end": 18.090000000000003,
      "text": "The duck?"
    },
    {
      "clip": 9,
      "who": "berry",
      "start": 18.340000000000003,
      "end": 20.160000000000004,
      "text": "No. Something behind it."
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 20.410000000000004,
      "end": 23.290000000000003,
      "text": "Sorry, little one. Important investigation."
    },
    {
      "clip": 11,
      "who": "cherry",
      "start": 23.540000000000003,
      "end": 25.17,
      "text": "We might be blocking its door."
    },
    {
      "clip": 12,
      "who": "berry",
      "start": 25.42,
      "end": 27.26,
      "text": "Oh. You're not a toy."
    },
    {
      "clip": 13,
      "who": "benny",
      "start": 27.51,
      "end": 29.53,
      "text": "Please tell me that's a fancy night-light."
    },
    {
      "clip": 14,
      "who": "berry",
      "start": 29.78,
      "end": 32.47,
      "text": "It's trying to go up, but it keeps falling back."
    },
    {
      "clip": 15,
      "who": "cherry",
      "start": 32.72,
      "end": 33.86,
      "text": "Look where it's pointing."
    },
    {
      "clip": 16,
      "who": "berry",
      "start": 34.11,
      "end": 35.94,
      "text": "I think somebody's missing from up there."
    },
    {
      "clip": 17,
      "who": "benny",
      "start": 36.19,
      "end": 38.379999999999995,
      "text": "That's going to be an awkward return address."
    }
