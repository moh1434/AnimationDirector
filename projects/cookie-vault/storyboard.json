  "dialogue": [
    {
      "clip": 1,
      "who": "benny",
      "start": 0.25,
      "end": 2.36,
      "text": "These cookies are finally Benny-proof."
    },
    {
      "clip": 2,
      "who": "benny",
      "start": 2.53,
      "end": 5.64,
      "text": "They're for our big picnic. I'm protecting them until tomorrow."
    },
    {
      "clip": 3,
      "who": "berry",
      "start": 5.89,
      "end": 6.819999999999999,
      "text": "Where's the key?"
    },
    {
      "clip": 4,
      "who": "benny",
      "start": 7.069999999999999,
      "end": 9.16,
      "text": "My pocket. For emergencies."
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 9.41,
      "end": 10.21,
      "text": "Such as?"
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 10.46,
      "end": 12.14,
      "text": "Finding out whether the lock works."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 12.39,
      "end": 13.57,
      "text": "You've already opened it."
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 13.82,
      "end": 16.23,
      "text": "Security testing. I found a serious weakness."
    },
    {
      "clip": 9,
      "who": "berry",
      "start": 16.48,
      "end": 17.215,
      "text": "The pocket?"
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 17.465,
      "end": 18.62,
      "text": "The pocket."
    },
    {
      "clip": 11,
      "who": "benny",
      "start": 18.77,
      "end": 20.63,
      "text": "There. Impossible to reach."
    },
    {
      "clip": 12,
      "who": "berry",
      "start": 20.88,
      "end": 21.7,
      "text": "And the stool?"
    },
    {
      "clip": 13,
      "who": "benny",
      "start": 21.95,
      "end": 23.22,
      "text": "Unrelated furniture."
    },
    {
      "clip": 14,
      "who": "berry",
      "start": 23.47,
      "end": 24.884999999999998,
      "text": "How's the security business?"
    },
    {
      "clip": 15,
      "who": "benny",
      "start": 25.134999999999998,
      "end": 28.25,
      "text": "Constantly evolving. Unfortunately, so is the criminal."
    },
    {
      "clip": 16,
      "who": "benny",
      "start": 28.4,
      "end": 31.055,
      "text": "You keep this. Whatever I say, don't give it back."
    },
    {
      "clip": 17,
      "who": "berry",
      "start": 31.305,
      "end": 33.63,
      "text": "Finally. How many cookies did we save?"
    },
    {
      "clip": 18,
      "who": "benny",
      "start": 33.88,
      "end": 34.575,
      "text": "Let me check."
    },
    {
      "clip": 19,
      "who": "berry",
      "start": 34.825,
      "end": 35.440000000000005,
      "text": "I'll check."
    },
    {
      "clip": 20,
      "who": "berry",
      "start": 35.59,
      "end": 36.17,
      "text": "Benny."
    },
    {
      "clip": 21,
      "who": "benny",
      "start": 36.42,
      "end": 38.36004166666667,
      "text": "I tested it after every improvement."
    },
    {
      "clip": 22,
      "who": "berry",
      "start": 38.61004166666667,
      "end": 40.43004166666667,
      "text": "You ate the entire security budget."
    }
  ],
