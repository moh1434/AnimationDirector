  "dialogue": [
    {
      "clip": 1,
      "who": "berry",
      "start": 0.25,
      "end": 1.36,
      "text": "That was our street."
    },
    {
      "clip": 2,
      "who": "benny",
      "start": 1.61,
      "end": 4.48,
      "text": "I know. Thought we'd go by the swings."
    },
    {
      "clip": 3,
      "who": "berry",
      "start": 4.73,
      "end": 4.99,
      "text": "What for?"
    },
    {
      "clip": 4,
      "who": "benny",
      "start": 5.24,
      "end": 7.27,
      "text": "Nothing. It's been a while."
    },
    {
      "clip": 5,
      "who": "berry",
      "start": 7.52,
      "end": 10.62,
      "text": "You used to duck driving past here."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 10.87,
      "end": 13.739999999999998,
      "text": "Cherry could spot those swings dead asleep."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 13.989999999999998,
      "end": 16.389999999999997,
      "text": "And there you'd be, pushing her in her pajamas."
    },
    {
      "clip": 8,
      "who": "benny",
      "start": 16.639999999999997,
      "end": 18.759999999999998,
      "text": "You always said one more push."
    },
    {
      "clip": 9,
      "who": "berry",
      "start": 19.009999999999998,
      "end": 21.689999999999998,
      "text": "She had the hiccups from laughing. I liked that."
    },
    {
      "clip": 10,
      "who": "benny",
      "start": 21.939999999999998,
      "end": 23.9,
      "text": "We could go round by the school, too."
    },
    {
      "clip": 11,
      "who": "berry",
      "start": 24.15,
      "end": 26.139999999999997,
      "text": "Benny, could you take this next left?"
    },
    {
      "clip": 12,
      "who": "benny",
      "start": 26.389999999999997,
      "end": 28.019999999999996,
      "text": "Yeah. Sure."
    },
    {
      "clip": 13,
      "who": "berry",
      "start": 28.269999999999996,
      "end": 30.814999999999998,
      "text": "I did like going past the swings."
    },
    {
      "clip": 14,
      "who": "benny",
      "start": 31.064999999999998,
      "end": 32.224999999999994,
      "text": "I should've asked."
    },
    {
      "clip": 15,
      "who": "benny",
      "start": 33.02499999999999,
      "end": 34.794999999999995,
      "text": "I just miss talking in the car."
    },
    {
      "clip": 16,
      "who": "berry",
      "start": 35.044999999999995,
      "end": 37.41499999999999,
      "text": "I've been thinking about that front step since lunch."
    },
    {
      "clip": 17,
      "who": "benny",
      "start": 37.66499999999999,
      "end": 38.41499999999999,
      "text": "The step?"
    },
    {
      "clip": 18,
      "who": "berry",
      "start": 38.66499999999999,
      "end": 42.084999999999994,
      "text": "It's still warm around now. The girls won't be back till five."
    },
    {
      "clip": 19,
      "who": "berry",
      "start": 42.88499999999999,
      "end": 45.05499999999999,
      "text": "I wanted to take my shoes off and sit there."
    },
    {
      "clip": 20,
      "who": "benny",
      "start": 45.30499999999999,
      "end": 47.85499999999999,
      "text": "Oh. And I drove right past it."
    },
    {
      "clip": 21,
      "who": "berry",
      "start": 48.10499999999999,
      "end": 49.74499999999999,
      "text": "Twice, if you'd had your way."
    },
    {
      "clip": 22,
      "who": "benny",
      "start": 49.99499999999999,
      "end": 51.37499999999999,
      "text": "Thought you might want this."
    },
    {
      "clip": 23,
      "who": "berry",
      "start": 51.62499999999999,
      "end": 52.60499999999999,
      "text": "Get yours too?"
    },
    {
      "clip": 24,
      "who": "berry",
      "start": 53.264999999999986,
      "end": 54.999999999999986,
      "text": "You know what I miss about those drives?"
    },
    {
      "clip": 25,
      "who": "benny",
      "start": 55.249999999999986,
      "end": 55.83999999999999,
      "text": "What?"
    },
    {
      "clip": 26,
      "who": "berry",
      "start": 56.08999999999999,
      "end": 57.90999999999999,
      "text": "We used to pick a house we'd buy."
    },
    {
      "clip": 27,
      "who": "benny",
      "start": 58.15999999999999,
      "end": 60.249999999999986,
      "text": "Little green one with the crooked porch?"
    },
    {
      "clip": 28,
      "who": "berry",
      "start": 60.499999999999986,
      "end": 62.05999999999999,
      "text": "You picked that one every time."
    }
  ],
