{
  "voicesFrom": "tts.json (berry take 1, benny take 1)",
  "cast": {
    "berry": {
      "preset": "berry",
      "name": "Berry"
    },
    "benny": {
      "preset": "benny",
      "name": "Benny"
    }
  },
  "clips": [
    {
      "who": "berry",
      "file": "voices/01-berry.wav",
      "text": "That was our street."
    },
    {
      "who": "benny",
      "file": "voices/02-benny.wav",
      "text": "I know. Thought we'd go by the swings."
    },
    {
      "who": "berry",
      "file": "voices/03-berry.wav",
      "text": "What for?"
    },
    {
      "who": "benny",
      "file": "voices/04-benny.wav",
      "text": "Nothing. It's been a while."
    },
    {
      "who": "berry",
      "file": "voices/05-berry.wav",
      "text": "You used to duck driving past here.",
      "gap": 2.4
    },
    {
      "who": "benny",
      "file": "voices/06-benny.wav",
      "text": "Cherry could spot those swings dead asleep."
    },
    {
      "who": "berry",
      "file": "voices/07-berry.wav",
      "text": "And there you'd be, pushing her in her pajamas."
    },
    {
      "who": "benny",
      "file": "voices/08-benny.wav",
      "text": "You always said one more push."
    },
    {
      "who": "berry",
      "file": "voices/09-berry.wav",
      "text": "She had the hiccups from laughing. I liked that."
    },
    {
      "who": "benny",
      "file": "voices/10-benny.wav",
      "text": "We could go round by the school, too.",
      "gap": 1.2
    },
    {
      "who": "berry",
      "file": "voices/11-berry.wav",
      "text": "Benny, could you take this next left?"
    },
    {
      "who": "benny",
      "file": "voices/12-benny.wav",
      "text": "Yeah. Sure."
    },
    {
      "who": "berry",
      "file": "voices/13-berry.wav",
      "text": "I did like going past the swings.",
      "gap": 3.6
    },
    {
      "who": "benny",
      "file": "voices/14-benny.wav",
      "text": "I should've asked.",
      "gap": 2.2
    },
    {
      "who": "benny",
      "file": "voices/15-benny.wav",
      "text": "I just miss talking in the car.",
      "gap": 0.8
    },
    {
      "who": "berry",
      "file": "voices/16-berry.wav",
      "text": "I've been thinking about that front step since lunch."
    },
    {
      "who": "benny",
      "file": "voices/17-benny.wav",
      "text": "The step?"
    },
    {
      "who": "berry",
      "file": "voices/18-berry.wav",
      "text": "It's still warm around now. The girls won't be back till five."
    },
    {
      "who": "berry",
      "file": "voices/19-berry.wav",
      "text": "I wanted to take my shoes off and sit there.",
      "gap": 0.8
    },
    {
      "who": "benny",
      "file": "voices/20-benny.wav",
      "text": "Oh. And I drove right past it."
    },
    {
      "who": "berry",
      "file": "voices/21-berry.wav",
      "text": "Twice, if you'd had your way."
    },
    {
      "who": "benny",
      "file": "voices/22-benny.wav",
      "text": "Thought you might want this.",
      "gap": 3.2
    },
    {
      "who": "berry",
      "file": "voices/23-berry.wav",
      "text": "Get yours too?"
    },
    {
      "who": "berry",
      "file": "voices/24-berry.wav",
      "text": "You know what I miss about those drives?",
      "gap": 4.4
    },
    {
      "who": "benny",
      "file": "voices/25-benny.wav",
      "text": "What?"
    },
    {
      "who": "berry",
      "file": "voices/26-berry.wav",
      "text": "We used to pick a house we'd buy."
    },
    {
      "who": "benny",
      "file": "voices/27-benny.wav",
      "text": "Little green one with the crooked porch?"
    },
    {
      "who": "berry",
      "file": "voices/28-berry.wav",
      "text": "You picked that one every time."
    }
  ]
}
