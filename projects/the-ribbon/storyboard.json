  "dialogue": [
    {
      "clip": 1,
      "who": "berry",
      "start": 0.25,
      "end": 2.04,
      "text": "Who opened this while I was gone?"
    },
    {
      "clip": 2,
      "who": "benny",
      "start": 2.29,
      "end": 5.3,
      "text": "Before anyone says anything, I respect privacy."
    },
    {
      "clip": 3,
      "who": "cherry",
      "start": 5.55,
      "end": 7.949999999999999,
      "text": "That's a very specific opening statement."
    },
    {
      "clip": 4,
      "who": "berry",
      "start": 8.2,
      "end": 10.35,
      "text": "I left you two alone for one whole minute."
    },
    {
      "clip": 5,
      "who": "cherry",
      "start": 10.6,
      "end": 14.149999999999999,
      "text": "I stayed here. Benny left for water, then came back."
    },
    {
      "clip": 6,
      "who": "benny",
      "start": 14.399999999999999,
      "end": 17.32,
      "text": "Which proves I was busy doing something completely normal."
    },
    {
      "clip": 7,
      "who": "berry",
      "start": 17.57,
      "end": 20.21,
      "text": "You both had time. Did anybody else come in?"
    },
    {
      "clip": 8,
      "who": "cherry",
      "start": 20.46,
      "end": 21.92,
      "text": "No. Just us."
    },
    {
      "clip": 9,
      "who": "benny",
      "start": 22.17,
      "end": 24.580000000000002,
      "text": "Cherry has scissors. Case closed."
    },
    {
      "clip": 10,
      "who": "cherry",
      "start": 24.830000000000002,
      "end": 26.07,
      "text": "For my snack bag."
    },
    {
      "clip": 11,
      "who": "benny",
      "start": 26.32,
      "end": 28.86,
      "text": "That's exactly what somebody with scissors would say."
    },
    {
      "clip": 12,
      "who": "berry",
      "start": 29.11,
