  "clips": [
    {
      "who": "wendy",
      "file": "voices/01-wendy.wav",
      "text": "Just play. Pretend I'm not here."
    },
    {
      "who": "cherry",
      "file": "voices/02-cherry.wav",
      "text": "You're breathing on me.",
      "gap": 1.6
    },
    {
      "who": "wendy",
      "file": "voices/03-wendy.wav",
      "text": "Sorry. Is the jump too high?"
    },
    {
      "who": "cherry",
      "file": "voices/04-cherry.wav",
      "text": "It's good."
    },
    {
      "who": "wendy",
      "file": "voices/05-wendy.wav",
      "text": "Too low?"
    },
    {
      "who": "cherry",
      "file": "voices/06-cherry.wav",
      "text": "It's good, Wendy."
    },
    {
      "who": "benny",
      "file": "voices/07-benny.wav",
      "text": "Taste this. More salt?",
      "gap": 1.6
    },
    {
      "who": "cherry",
      "file": "voices/08-cherry.wav",
      "text": "It's good."
    },
    {
      "who": "wendy",
      "file": "voices/09-wendy.wav",
      "text": "You didn't even taste it.",
      "gap": 1.5
    },
    {
      "who": "cherry",
      "file": "voices/10-cherry.wav",
      "text": "He looked hopeful."
    },
    {
      "who": "wendy",
      "file": "voices/11-wendy.wav",
      "text": "Are you doing that to me?",
      "gap": 2.2
    },
    {
      "who": "wendy",
      "file": "voices/12-wendy.wav",
      "text": "The tower's the other way. Where are you going?",
      "gap": 1
    },
    {
      "who": "cherry",
      "file": "voices/13-cherry.wav",
      "text": "Back to the snail."
    },
    {
      "who": "wendy",
      "file": "voices/14-wendy.wav",
      "text": "What snail?"
    },
    {
      "who": "cherry",
      "file": "voices/15-cherry.wav",
      "text": "By the wall. If you walk slowly, it comes with you."
    },
    {
      "who": "wendy",
      "file": "voices/16-wendy.wav",
      "text": "That's a bug. I'm taking it out tonight.",
      "gap": 0.4
    },
    {
      "who": "wendy",
      "file": "voices/17-wendy.wav",
      "text": "The tower is the game. Do you like the tower?",
      "gap": 1
    },
    {
      "who": "cherry",
      "file": "voices/18-cherry.wav",
      "text": "It feels like homework."
    },
    {
      "who": "wendy",
      "file": "voices/19-wendy.wav",
      "text": "I've worked on that since March.",
      "gap": 3.1
    },
    {
      "who": "cherry",
      "file": "voices/20-cherry.wav",
      "text": "You asked if it was good. It is good.",
      "gap": 0.6
    },
    {
      "who": "cherry",
      "file": "voices/21-cherry.wav",
      "text": "You didn't ask if I liked it.",
      "gap": 0.64
    },
    {
      "who": "wendy",
      "file": "voices/22-wendy.wav",
      "text": "Okay. I need to work now."
    },
    {
      "who": "cherry",
      "file": "voices/23-cherry.wav",
      "text": "Are you mad?"
    },
    {
      "who": "wendy",
      "file": "voices/24-wendy.wav",
      "text": "I'm working."
    },
    {
      "who": "wendy",
      "file": "voices/25-wendy.wav",
      "text": "Come on. This way.",
      "gap": 8.2
    },
    {
      "who": "wendy",
      "file": "voices/26-wendy.wav",
      "text": "How long have you been there?",
      "gap": 1.8
    },
    {
      "who": "cherry",
      "file": "voices/27-cherry.wav",
      "text": "A while. You were working."
    },
    {
      "who": "wendy",
      "file": "voices/28-wendy.wav",
      "text": "I was walking a snail."
    },
    {
      "who": "cherry",
      "file": "voices/29-cherry.wav",
      "text": "Did you take it out?",
      "gap": 2.1
    },
    {
      "who": "wendy",
      "file": "voices/30-wendy.wav",
      "text": "No. It was supposed to be a rock."
    },
    {
      "who": "wendy",
      "file": "voices/31-wendy.wav",
      "text": "I don't know why it follows you.",
      "gap": 0.8
    },
    {
      "who": "cherry",
      "file": "voices/32-cherry.wav",
      "text": "Maybe it likes you."
    },
    {
      "who": "wendy",
      "file": "voices/33-wendy.wav",
      "text": "It stung, the homework thing.",
      "gap": 1.4
    },
    {
      "who": "cherry",
      "file": "voices/34-cherry.wav",
      "text": "I know. That's why I said good."
    },
    {
      "who": "wendy",
      "file": "voices/35-wendy.wav",
      "text": "I can be stung. I still want to know."
    },
    {
      "who": "cherry",
      "file": "voices/36-cherry.wav",
      "text": "Is this testing?",
      "gap": 1.2
    },
    {
      "who": "wendy",
      "file": "voices/37-wendy.wav",
      "text": "No. I just want to see where you take it.",
      "gap": 2.4
    },
    {
      "who": "cherry",
      "file": "voices/38-cherry.wav",
      "text": "Too salty.",
      "gap": 3.4
    },
    {
      "who": "benny",
      "file": "voices/39-benny.wav",
      "text": "You said it was good!"
    }
  ]
}
