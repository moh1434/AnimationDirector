{
  "language": "en",
  "takes": 1,
  "voices": {
    "wendy": {
      "library": "wendy",
      "chunkPerLine": true
    },
    "cherry": {
      "library": "cherry",
      "chunkPerLine": true
    },
    "benny": {
      "library": "benny",
      "chunkPerLine": true
    }
  },
  "lines": [
    {
      "who": "wendy",
      "text": "Just play. Pretend I'm not here."
    },
    {
      "who": "cherry",
      "text": "You're breathing on me."
    },
    {
      "who": "wendy",
      "text": "Sorry. Is the jump too high?"
    },
    {
      "who": "cherry",
      "text": "It's good."
    },
    {
      "who": "wendy",
      "text": "Too low?"
    },
    {
      "who": "cherry",
      "text": "It's good, Wendy."
    },
    {
      "who": "benny",
      "text": "Taste this. More salt?"
    },
    {
      "who": "cherry",
      "text": "It's good."
    },
    {
      "who": "wendy",
      "text": "You didn't even taste it."
    },
    {
      "who": "cherry",
      "text": "He looked hopeful."
    },
    {
      "who": "wendy",
      "text": "Are you doing that to me?"
    },
    {
      "who": "wendy",
      "text": "The tower's the other way. Where are you going?"
    },
    {
      "who": "cherry",
      "text": "Back to the snail."
    },
    {
      "who": "wendy",
      "text": "What snail?"
    },
    {
      "who": "cherry",
      "text": "By the wall. If you walk slowly, it comes with you."
    },
    {
      "who": "wendy",
      "text": "That's a bug. I'm taking it out tonight."
    },
    {
      "who": "wendy",
      "text": "The tower is the game. Do you like the tower?"
    },
    {
      "who": "cherry",
      "text": "It feels like homework."
    },
    {
      "who": "wendy",
      "text": "I've worked on that since March."
    },
    {
      "who": "cherry",
      "text": "You asked if it was good. It is good."
    },
    {
      "who": "cherry",
      "text": "You didn't ask if I liked it."
    },
    {
      "who": "wendy",
      "text": "Okay. I need to work now."
    },
    {
      "who": "cherry",
      "text": "Are you mad?"
    },
    {
      "who": "wendy",
      "text": "I'm working."
    },
    {
      "who": "wendy",
      "text": "Come on. This way."
    },
    {
      "who": "wendy",
      "text": "How long have you been there?"
    },
    {
      "who": "cherry",
      "text": "A while. You were working."
    },
    {
      "who": "wendy",
      "text": "I was walking a snail."
    },
    {
      "who": "cherry",
      "text": "Did you take it out?"
    },
    {
      "who": "wendy",
      "text": "No. It was supposed to be a rock."
    },
    {
      "who": "wendy",
      "text": "I don't know why it follows you."
    },
    {
      "who": "cherry",
      "text": "Maybe it likes you."
    },
    {
      "who": "wendy",
      "text": "It stung, the homework thing."
    },
    {
      "who": "cherry",
      "text": "I know. That's why I said good."
    },
    {
      "who": "wendy",
      "text": "I can be stung. I still want to know."
    },
    {
      "who": "cherry",
      "text": "Is this testing?"
    },
    {
      "who": "wendy",
      "text": "No. I just want to see where you take it."
    },
    {
      "who": "cherry",
      "text": "Too salty."
    },
    {
      "who": "benny",
      "text": "You said it was good!"
    }
  ]
}